root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = tab
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java,xml,yml,yaml,properties,md,adoc}]
indent_style = space
indent_size = 4

[*.{json,js,ts,css,html}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[pom.xml]
indent_size = 2
